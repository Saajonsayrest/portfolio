---
/**
 * One record in an `.entries` list, the same two column grid as a project row: title, org line
 * and period on the left, the body on the right. Slot `org` is the second line, the default slot
 * is the body (a list, a paragraph).
 */
interface Props {
  title: string;
  meta?: string;
  id?: string;
  index?: number;
}

const { title, meta, id, index = 0 } = Astro.props;
---

<article class="entry" id={id} data-reveal style={`--i:${Math.min(index, 3)}`}>
  <div>
    <h3>{title}</h3>
    {Astro.slots.has('org') && <p class="org"><slot name="org" /></p>}
    {meta && <span class="meta">{meta}</span>}
  </div>
  <div><slot /></div>
</article>
