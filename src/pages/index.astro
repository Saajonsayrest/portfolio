---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site, projects, experience, services, playListings } from '../data/profile';

const featured = projects.filter((p) => p.featured);
const now = experience[0];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
---

<Base schema={schema}>
  <Hero
    eyebrow="Flutter on top, native Kotlin underneath"
    title="Sajon Shrestha."
    accent="Mobile engineer in Kathmandu."
    lede="Seven products across thirteen Google Play listings, one past 100,000 installs. I own the parts teams usually outsource. A forked native video player, subscription billing and the release pipeline itself."
  >
    <Fragment slot="actions">
      <a class="link" href="/work/">See the work<span class="arrow">›</span></a>
      <a class="link" href={`mailto:${site.email}`}>Email me<span class="arrow">›</span></a>
    </Fragment>
    <div class="apps" data-reveal style="--i:4" aria-label="On Google Play">
      {playListings.map((a) => (
        <a href={a.url} rel="noopener" target="_blank" title={a.name}>
          <img class="icon" src={a.icon} alt={a.name} width="96" height="96" decoding="async" />
        </a>
      ))}
    </div>
    <p class="meta apps-note" data-reveal style="--i:5">On Google Play</p>
  </Hero>

  <Figure value="110,000+">
    installs across four Google Play apps for Nepal's fifth largest internet provider, built and maintained as the
    only mobile developer.
  </Figure>

  <Section id="work" heading="Selected work">
    <div class="rows">
      {featured.map((p, i) => <ProjectRow project={p} compact index={i} />)}
    </div>
    <p class="more" data-reveal>
      <a class="link" href="/work/">All work and store listings<span class="arrow">›</span></a>
    </p>
  </Section>

  <Section id="take-on" heading="What I take on" tone="soft">
    <div class="list2">
      {services.map((s, i) => (
        <div data-reveal style={`--i:${Math.min(i, 3)}`}>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="now" heading="Now">
    <div class="prose" data-reveal>
      <p>
        <strong>{now.role}</strong> at <a href={now.companyUrl} rel="noopener">{now.company}</a>, {now.period}.
      </p>
      <p>{now.bullets[0]} {now.bullets[1]}</p>
      <p class="more"><a class="link" href="/cv/">Read the CV<span class="arrow">›</span></a></p>
    </div>
  </Section>
</Base>
