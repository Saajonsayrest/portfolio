---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site, projects, experience, services, playListings } from '../data/profile';

const featured = projects.filter((p) => p.featured);
const now = experience[0];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
---

<Base schema={schema}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal style="--i:0">Sajon Shrestha, mobile engineer in Kathmandu</p>
      <h1 class="display" data-reveal style="--i:1">Flutter on top.<span>Native Kotlin underneath.</span></h1>
      <p class="lede" data-reveal style="--i:2">
        Seven products public on Google Play, one past 100,000 installs. I own the parts teams usually outsource.
        A forked native video player, subscription billing and the release pipeline itself.
      </p>
      <div class="actions" data-reveal style="--i:3">
        <a class="link" href="/work/">See the work<span class="arrow">›</span></a>
        <a class="link" href={`mailto:${site.email}`}>Email me<span class="arrow">›</span></a>
      </div>
      <div class="apps" data-reveal style="--i:4" aria-label="On Google Play">
        {playListings.map((a) => (
          <a href={a.url} rel="noopener" target="_blank" title={a.name}>
            <img class="icon" src={a.icon} alt={a.name} width="96" height="96" decoding="async" />
          </a>
        ))}
        <span class="meta">On Google Play</span>
      </div>
    </div>
  </section>

  <Section tone="tint">
    <p class="figure" data-reveal>110,000+</p>
    <p class="figure-note" data-reveal style="--i:1">
      installs across four Google Play apps for Nepal's fifth largest internet provider, built and maintained as
      the only mobile developer.
    </p>
  </Section>

  <Section id="work">
    <h2 class="h2" data-reveal>Selected work</h2>
    <div class="rows">
      {featured.map((p, i) => <ProjectRow project={p} compact index={i} />)}
    </div>
    <p class="more" data-reveal>
      <a class="link" href="/work/">All work and store listings<span class="arrow">›</span></a>
    </p>
  </Section>

  <Section id="take-on" tone="soft">
    <h2 class="h2" data-reveal>What I take on</h2>
    <div class="list2">
      {services.map((s, i) => (
        <div data-reveal style={`--i:${Math.min(i, 3)}`}>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="now" label="Now">
    <div class="prose" data-reveal>
      <p>
        <strong>{now.role}</strong> at <a href={now.companyUrl} rel="noopener">{now.company}</a>, {now.period}.
      </p>
      <p>{now.bullets[0]} {now.bullets[1]}</p>
      <p class="more"><a class="link" href="/cv/">Read the CV<span class="arrow">›</span></a></p>
    </div>
  </Section>
</Base>
