---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import Section from '../components/Section.astro';
import { site } from '../data/profile';

const title = 'Contact';
const description = 'Contact Sajon Shrestha, Flutter and mobile engineer in Kathmandu, Nepal. Email, WhatsApp, LinkedIn, GitHub, ORCID.';
---

<Base title={title} description={description}>
  <Hero small eyebrow="Contact" lede="I am in Kathmandu, Nepal (UTC+5:45) and work with clients in US time zones. WhatsApp is fine for a quick message.">
    <Fragment slot="title">
      Email is the fastest.
      <span><a class="email" href={`mailto:${site.email}`}>{site.email}</a></span>
    </Fragment>
    <Fragment slot="actions">
      <a class="link" href={`mailto:${site.email}`}>Email me<span class="arrow">›</span></a>
      <button class="btn ghost copy" type="button" data-copy={site.email}>Copy address</button>
      <a class="btn ghost" href={site.whatsapp.url} rel="noopener" target="_blank">WhatsApp</a>
    </Fragment>
  </Hero>

  <Figure value="UTC+5:45">
    Kathmandu time. A US morning is my evening, so calls land in that overlap. Email works at any hour.
  </Figure>

  <Section id="elsewhere" heading="Elsewhere">
    <div class="links-list" data-reveal>
      <a class="link" href={site.whatsapp.url} rel="noopener" target="_blank">WhatsApp {site.whatsapp.number}<span class="arrow">↗</span></a>
      <a class="link" href={site.links.linkedin} rel="me noopener">LinkedIn<span class="arrow">↗</span></a>
      <a class="link" href={site.links.github} rel="me noopener">GitHub<span class="arrow">↗</span></a>
      <a class="link" href={site.links.orcid} rel="me noopener">ORCID<span class="arrow">↗</span></a>
    </div>
  </Section>

  <Section id="clients" heading="For clients" tone="soft">
    <p class="prose" data-reveal>
      Send the app idea, the platforms you need and the date you have in mind. A paragraph is enough to start.
      See <a href="/#take-on">what I take on</a>.
    </p>
  </Section>

  <Section id="admissions" heading="For supervisors and admissions">
    <p class="prose" data-reveal>
      The <a href="/about/#research">research section</a> has my interests and the final year project. The
      <a href="/cv/">CV</a> is on this site. Transcripts and references come on request, by email.
    </p>
  </Section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = label), 1500);
      } catch {
        window.location.href = `mailto:${value}`;
      }
    });
  });
</script>
