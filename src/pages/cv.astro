---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { site, experience, education, skills, languages } from '../data/profile';

const title = 'CV';
const description =
  'CV of Sajon Shrestha, Flutter and mobile engineer. Webpoint Solutions, Classic Tech, Sulav Pay. BE Computer Engineering, Tribhuvan University. Download as PDF.';

// The PDF is copied in by hand from the CV build. Only offer it when it is really there.
const hasPdf = fs.existsSync(path.join(process.cwd(), 'public', site.cvFile));
---

<Base title={title} description={description}>
  <Hero small eyebrow="CV" title="Four years of mobile." accent="Everything the PDF says, on one page.">
    <Fragment slot="lede">
      {hasPdf ? 'Download the PDF or read it here, the content is the same.' : 'Print this page for a PDF copy.'} Last
      updated September 2026.
    </Fragment>
    <Fragment slot="actions">
      {hasPdf ? (
        <a class="btn no-print" href={site.cvFile}>Download PDF</a>
      ) : (
        <button class="btn no-print" type="button" onclick="window.print()">Print or save as PDF</button>
      )}
      <a class="link no-print" href="/work/">See the work<span class="arrow">›</span></a>
    </Fragment>
  </Hero>

  {/* The note names every role in `experience`, oldest first. Add a role there, add it here. */}
  <Figure value={String(experience.length)}>
    roles since 2022. An internship, a fintech wallet, Nepal's fifth largest ISP, then a US-owned team where I lead
    mobile delivery today.
  </Figure>

  <Section id="experience" heading="Experience">
    <div class="entries">
      {experience.map((e, i) => (
        <Entry title={e.role} meta={e.period} index={i}>
          <Fragment slot="org">
            {e.companyUrl ? <a href={e.companyUrl} rel="noopener">{e.company}</a> : e.company}, {e.place}
          </Fragment>
          <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
        </Entry>
      ))}
    </div>
  </Section>

  <Section id="education" heading="Education" tone="soft">
    <div class="entries">
      <Entry title={education.degree} meta={education.period}>
        <Fragment slot="org">
          <a href={education.schoolUrl} rel="noopener">{education.school}</a>,
          <a href={education.universityUrl} rel="noopener">{education.university}</a>, {education.place}
        </Fragment>
        <p>{education.note}</p>
      </Entry>
    </div>
  </Section>

  <Section id="skills" heading="Skills">
    <dl class="skills" data-reveal>
      {skills.map((s) => (
        <>
          <dt>{s.area}</dt>
          <dd>{s.items}</dd>
        </>
      ))}
    </dl>
  </Section>

  <Section id="languages" heading="Languages" tone="soft">
    <dl class="skills" data-reveal>
      {languages.map((l) => (
        <>
          <dt>{l.name}</dt>
          <dd>{l.level}</dd>
        </>
      ))}
    </dl>
    <p class="muted more" data-reveal>References are available on request and are never listed here.</p>
  </Section>
</Base>
