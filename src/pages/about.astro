---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { summary, research, education, languages } from '../data/profile';

const title = 'About';
const description =
  'About Sajon Shrestha, Flutter and mobile engineer in Kathmandu. Background, research interests, the RAGE final year project, education at Kantipur Engineering College, Tribhuvan University.';
---

<Base title={title} description={description}>
  <Hero small eyebrow="About" title="Mobile engineer since 2022." accent="Kathmandu, working on US time." lede={summary[0]}>
    <Fragment slot="actions">
      <a class="link" href="#research">Research<span class="arrow">›</span></a>
      <a class="link" href="/cv/">Full CV<span class="arrow">›</span></a>
    </Fragment>
  </Hero>

  <Figure value="12h">
    the gap between Kathmandu and the US clients I lead mobile delivery for, inside a twenty person team. Client
    meetings and demos happen on video, in English.
  </Figure>

  <Section id="in-short" heading="In short">
    <div class="prose" data-reveal>
      {summary.slice(1).map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section id="research" heading="Research" tone="soft">
    <div class="prose" data-reveal>
      {research.interests.map((p) => <p>{p}</p>)}
    </div>
    <div class="entries" style="margin-top: 2.5rem">
      <Entry title={research.project.name} meta={research.project.context}>
        <Fragment slot="org">{research.project.stack.join(', ')}</Fragment>
        <ul>{research.project.bullets.map((b) => <li>{b}</li>)}</ul>
        <p class="muted note">Supervised by {research.project.supervisor}.</p>
      </Entry>
    </div>
  </Section>

  <Section id="education" heading="Education">
    <div class="entries">
      <Entry title={education.degree} meta={education.period}>
        <Fragment slot="org">
          <a href={education.schoolUrl} rel="noopener">{education.school}</a>,
          <a href={education.universityUrl} rel="noopener">{education.university}</a>, {education.place}
        </Fragment>
        <p>{education.note}</p>
      </Entry>
    </div>
  </Section>

  <Section id="languages" heading="Languages" tone="soft">
    <dl class="skills" data-reveal>
      {languages.map((l) => (
        <>
          <dt>{l.name}</dt>
          <dd>{l.level}</dd>
        </>
      ))}
    </dl>
    <p class="muted" style="margin-top: 1.5rem" data-reveal>{research.english}</p>
    <p class="more" data-reveal><a class="link" href="/cv/">Full CV<span class="arrow">›</span></a></p>
  </Section>
</Base>
